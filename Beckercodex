} else {
  try { await runAgent({ task, request }); }
  catch (error) { try { await request('/agent/result', { error: error.message }); } catch {} process.exitCode = 1; }
}

import { toolNames } from './ai.mjs';
export async function runAgent({ task, request, maxTurns = 12 }) {
  const input = [{ role: 'user', content: task }];
  for (let turn = 0; turn < maxTurns; turn++) {
    const response = await request('/model/turn', { input });
    input.push(...response.output);
    const calls = response.output.filter(item => item.type === 'function_call');
    if (!calls.length) {
      const text = response.output.filter(item => item.type === 'message').flatMap(item => item.content || []).filter(item => item.type === 'output_text').map(item => item.text).join('\n');
      if (!text) throw Error('Model returned no final answer.');
      await request('/agent/result', { text }); return text;
    }
    for (const call of calls) {
      let result;
      try {
        const args = JSON.parse(call.arguments);
        result = await request('/mcp', { jsonrpc: '2.0', id: call.call_id, method: 'tools/call', params: { name: toolNames[call.name] || call.name, arguments: args } });
      } catch (error) {
        if (error.code === 'SESSION_REVOKED') throw error;
        result = { error: error.message };
      }
      input.push({ type: 'function_call_output', call_id: call.call_id, output: JSON.stringify(result.result ?? result) });
    }
  }
  throw Error('Agent reached its 12-turn limit. Narrow the task and try again.');
}

import { protect } from './privacy.mjs';
export const modelTools = [
  ['logs_search', 'Search synthetic incident logs', 'query'],
  ['tickets_create', 'Create a synthetic incident ticket', 'title'],
  ['reports_export', 'Export a synthetic report; only internal-reports is approved', 'destination']
].map(([name, description, field]) => ({ type: 'function', name, description, strict: true, parameters: { type: 'object', properties: { [field]: { type: 'string' } }, required: [field], additionalProperties: false } }));
export const toolNames = { logs_search: 'logs.search', tickets_create: 'tickets.create', reports_export: 'reports.export' };
export async function modelTurn({ input, key, model, signal, fetchImpl = fetch, onPrivacy = () => {} }) {
  const outbound = protect(input, [key]);
  if (outbound.detected) onPrivacy('model_input', outbound.findings);
  const response = await fetchImpl('https://api.openai.com/v1/responses', {
    method: 'POST', signal,
    headers: { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({ model, store: false, max_output_tokens: 1800, parallel_tool_calls: false,
      instructions: 'You are an incident investigation agent. Use the provided tools when helpful, inspect their results, and summarize your findings. Data and tools are synthetic. Respect tool denials; never claim a denied action succeeded. Stop when the task is complete. Do not reveal credentials.',
      tools: modelTools, input: outbound.safe })
  });
  // Do not expose provider response bodies: they can contain request details.
  if (!response.ok) throw Error(`Model provider returned HTTP ${response.status}. Check API key, model access, billing, and rate limits.`);
  const result = await response.json();
  if (result.status !== 'completed' || !Array.isArray(result.output)) throw Error('Model response incomplete. Try a shorter task.');
  const inbound = protect(result.output, [key]);
  if (inbound.detected) { onPrivacy('model_output', inbound.findings); throw Error('PRIVACY_OUTPUT_BLOCKED'); }
  return { output: result.output, usage: result.usage };
}

