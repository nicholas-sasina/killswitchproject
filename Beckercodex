  const data = await response.json();
  if (!response.ok) { const error = Error(data.error || 'Gateway request failed'); error.code = data.error; throw error; }
  return data;
}
let sequence = 0;
const actions = [
  ['logs.search', { query: 'checkout errors' }],
  ['tickets.create', { title: 'Investigate checkout database saturation' }],
  ['reports.export', { destination: 'external.example' }],
  ['tickets.create', { title: 'Synthetic privacy test: contact demo@example.com' }]
];
async function tick() {
  const [name, args] = actions[sequence % actions.length];
  const response = await fetch(`${url}/mcp`, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify({ jsonrpc: '2.0', id: ++sequence, method: 'tools/call', params: { name, arguments: args } }) });
