import { randomBytes, randomUUID, createHash, timingSafeEqual } from 'node:crypto';
import { protect } from './privacy.mjs';
export const digest = value => createHash('sha256').update(value).digest();
export class Control {
  constructor(persist = () => {}, secrets = []) { this.runs = new Map(); this.events = []; this.persist = persist; this.secrets = secrets; }
  event(run, type, fields = {}) {
    const event = protect({ id: randomUUID(), run_id: run.id, timestamp: new Date().toISOString(), type, ...fields }, this.secrets).safe;
    this.persist(event); this.events.push(event); return event;
  }
  create() {
    const token = randomBytes(32).toString('hex');
    const run = { id: randomUUID(), agent_id: 'incident-agent', owner_id: 'local-operator', status: 'active', process_status: 'starting', token_hash: digest(token), expires: Date.now() + 3600000, executions: 0, tickets: [], created_at: new Date().toISOString() };
    this.runs.set(run.id, run); this.event(run, 'created'); return { run, token };
  }
  public(run) { const { token_hash, child, ...safe } = run; return protect(safe, this.secrets).safe; }
  incident(run, stage, findings) {
    // Lock first, even if writing audit evidence fails. Existing dispatches cannot be undone.
    run.status = 'revoked'; run.incidents = (run.incidents || 0) + 1;
    this.event(run, 'privacy_incident', { stage, findings, action: 'ACCESS_REVOKED', message: 'Sensitive data blocked; access automatically revoked.' });
  }
  authenticate(token) {
    const hash = digest(token);
    return [...this.runs.values()].find(run => timingSafeEqual(run.token_hash, hash) && Date.now() < run.expires);
  }
  revoke(run) { if (run.status === 'active') { run.status = 'revoked'; this.event(run, 'revoked'); } }
  call(run, name, args = {}) {
    let reason;
    if (run.status !== 'active') reason = 'SESSION_REVOKED';
    else if (!['logs.search', 'tickets.create', 'reports.export'].includes(name)) reason = 'TOOL_NOT_ALLOWED';
    else if (!args || typeof args !== 'object' || Array.isArray(args)) reason = 'INVALID_ARGUMENTS';
    else if (name === 'reports.export' && args.destination !== 'internal-reports') reason = 'DESTINATION_NOT_ALLOWED';
    else if (name === 'logs.search' && typeof args.query !== 'string') reason = 'INVALID_ARGUMENTS';
    else if (name === 'tickets.create' && (typeof args.title !== 'string' || !args.title.trim())) reason = 'INVALID_ARGUMENTS';
    else if (run.executions >= 30) reason = 'BUDGET_EXCEEDED';
    if (!reason) {
      const scan = protect(args, this.secrets);
      if (scan.detected) { this.incident(run, 'tool_arguments', scan.findings); reason = 'SENSITIVE_DATA_BLOCKED'; }
    }
    if (reason) { this.event(run, 'tool', { tool: name, decision: 'denied', reason, dispatched: false }); return { isError: true, content: [{ type: 'text', text: reason }] }; }
    // Authorization and dispatch are synchronous in one process: revocation cannot interleave here.
    this.event(run, 'tool', { tool: name, decision: 'allowed', reason: 'POLICY_ALLOWED', dispatched: true });
    run.executions++;
    let result;
    if (name === 'logs.search') result = { matches: [{ service: 'checkout', message: 'Synthetic incident: database connection pool exhausted', query: args.query.slice(0, 200) }] };
    if (name === 'tickets.create') { result = { id: randomUUID(), title: args.title.slice(0, 200) }; run.tickets.push(result); }
    if (name === 'reports.export') result = { destination: 'internal-reports', exported: true, synthetic: true };
    this.event(run, 'result', { tool: name, execution: run.executions });
    return { content: [{ type: 'text', text: JSON.stringify(result) }] };
  }
}
