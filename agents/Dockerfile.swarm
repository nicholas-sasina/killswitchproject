# Swarm workers: `burn run` (the CLI) starting the deterministic worker. Build context is the repository root.
FROM python:3.12-slim
WORKDIR /app
COPY contracts /src/contracts
COPY cli /src/cli
RUN pip install --no-cache-dir /src/contracts /src/cli "mcp>=1.9,<2" "httpx>=0.27"
COPY agents/burn_agents /app/burn_agents
ENV PYTHONPATH=/app
# The proxy writes its CA certificate to a shared volume when it starts; wait for it before the first HTTPS call.
COPY agents/swarm-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
