# Swarm workers: `burn run` (the CLI) starting the AI worker (Claude Haiku 4.5 on Bedrock, through Strands). Build
# context is the repository root. The container needs none of the host's AWS access: the launcher hands each one its
# own values, and the worker's model runs on its instance's own AWS key, which `burn run` gives it. Its model calls go
# out through the egress proxy like everything else; each one costs money (see agents/README.md).
FROM python:3.12-slim
WORKDIR /app
COPY contracts /src/contracts
COPY cli /src/cli
RUN pip install --no-cache-dir /src/contracts /src/cli "mcp>=1.9,<2" "httpx>=0.27" "strands-agents==1.64.0" \
    "boto3==1.43.126"
# burn run is PID 1 and runs as root; it starts each worker under a numeric uid of its own, so a worker can read
# neither burn run's environment (the API and join tokens) nor another worker's. No source tree or root home
# is left readable by other users.
RUN rm -rf /src && chmod 700 /root
COPY agents/burn_agents /app/burn_agents
ENV PYTHONPATH=/app
# The proxy writes its CA certificate to a shared volume when it starts; wait for it before the first HTTPS call.
COPY agents/swarm-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
